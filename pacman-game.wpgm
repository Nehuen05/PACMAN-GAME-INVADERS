import trampas.*
import wollok.game.*
import pacman.*
import direcciones.*
import bombasRandom.*


program juego {

  game.title("PAC MAN")
  game.addVisualCharacter(pacman)
  game.boardGround("fondo.jpg")
  game.height(15)
	game.width(15)
  game.start()

  //MOVIMIENTO PACMAN

  keyboard.left().onPressDo({ pacman.mover(izquierda)})
	keyboard.right().onPressDo({ pacman.mover(derecha)})
	keyboard.up().onPressDo({ pacman.mover(arriba)})
	keyboard.down().onPressDo({ pacman.mover(abajo)})

  // BOMBA PACMAN
  keyboard.b().onPressDo({pacman.ponerBomba() })
  

// BOMBAS AZULES
  game.schedule(5000, { game.addVisual(new BombaRandom (position = game.at(2, 10)))})
  game.schedule(25000,{ game.addVisual(new BombaRandom (position = game.at(7, 9)))})
  game.schedule(15000,{ game.addVisual(new BombaRandom (position = game.at(9, 10)))})

// COLISIONES 

  
}